#include <stdio.h>

void moveZeroes(int* nums, int n) {
    int pos = 0;  


    for (int i = 0; i < n; i++) {
        if (nums[i] != 0) {
            nums[pos++] = nums[i];
        }
    }

  
    while (pos < n) {
        nums[pos++] = 0;
    }
}

void printArray(int* arr, int n) {
    printf("[");
    for (int i = 0; i < n; i++) {
        printf("%d", arr[i]);
        if (i < n - 1) printf(", ");
    }
    printf("]\n");
}

int main() {
    int nums[] = {0, 1, 0, 3, 12};
    int n = sizeof(nums) / sizeof(nums[0]);

    printf("Before: ");
    printArray(nums, n);

    moveZeroes(nums, n);

    printf("After:  ");
    printArray(nums, n);

    return 0;
}
