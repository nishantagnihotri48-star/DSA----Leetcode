#include <stdio.h>
#include <stdbool.h>

bool searchMatrix(int** matrix, int rows, int cols, int target) {
    int lo = 0, hi = rows * cols - 1;

    while (lo <= hi) {
        int mid = lo + (hi - lo) / 2;
        int val = matrix[mid / cols][mid % cols];

        if (val == target)       return true;
        else if (val < target)   lo = mid + 1;
        else                     hi = mid - 1;
    }
    return false;
}

void printMatrix(int** m, int rows, int cols) {
    for (int i = 0; i < rows; i++) {
        printf("  [");
        for (int j = 0; j < cols; j++) {
            printf("%3d", m[i][j]);
            if (j < cols - 1) printf(",");
        }
        printf(" ]\n");
    }
}

int main() {
    int r0[] = {1,  3,  5,  7};
    int r1[] = {10, 11, 16, 20};
    int r2[] = {23, 30, 34, 60};
    int* matrix[] = {r0, r1, r2};
    int rows = 3, cols = 4;

    printf("Matrix:\n"); printMatrix(matrix, rows, cols);

    int targets[] = {3, 13};
    for (int t = 0; t < 2; t++) {
        printf("\nSearch %d → %s\n", targets[t],
               searchMatrix(matrix, rows, cols, targets[t]) ? "true" : "false");
    }
    return 0;
}
